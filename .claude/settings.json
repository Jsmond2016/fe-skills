{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Agent",
      "NotebookEdit",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(lsof *)",
      "Bash(ss *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/check-file-size.sh" }
        ]
      }
    ]
  }
}
