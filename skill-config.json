{
  "personal_skills": {
    "react-stack": {
      "enabled": true,
      "platforms": ["cursor", "claude"],
      "description": "React 全栈开发最佳实践 - 整合 React, ahooks, antd, TailwindCSS, Ramda, Jotai, TypeScript, Webpack/Vite, pnpm 等技术栈"
    },
    "tailwindcss": {
      "enabled": true,
      "platforms": ["cursor", "claude"],
      "description": "TailwindCSS utility-first CSS framework for rapid UI development"
    }
  },
  "platforms": {
    "cursor": {
      "path": "~/.cursor/skills",
      "enabled": true,
      "use_symlink": false
    },
    "claude": {
      "path": "~/.claude/skills",
      "enabled": true,
      "use_symlink": false
    }
  },
  "settings": {
    "backup_existing": true,
    "backup_dir": ".backups",
    "conflict_strategy": "backup",
    "verbose": false
  }
}
